<?xml version="1.0" encoding="utf-8"?>
<!--
  FULL EDITION ONLY (ADR-016). Everything that reads SMS or notifications is declared here, so the statement edition's
  merged manifest has no SMS permission, no SMS receiver and no notification listener. CI checks that.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read payment SMS. Android 13+ blocks these for sideloaded apps until the owner allows restricted settings. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application>
        <!-- Declared in the manifest, so Android wakes this process for ~100 ms per SMS and nothing runs in between. -->
        <receiver
            android:name=".ingest.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Bound and kept alive by Android itself once the owner grants Notification access. Catches RCS and UPI-app alerts. -->
        <service
            android:name=".ingest.NotificationCaptureService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
